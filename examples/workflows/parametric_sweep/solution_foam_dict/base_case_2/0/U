FoamFile
{
    version         2;
    format          ascii;
    class           volVectorField;
    location        "0";
    object          U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

Uinlet          ( 2 0 0 );

dimensions      [ 0 1 -1 0 0 0 0 ];

internalField   uniform ( 2 0 0 );

boundaryField
{
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform $Uinlet;
    }
    inlet
    {
        type            fixedValue;
        value           uniform ( 2 0 0 );
    }
    ".*"
    {
        type            noSlip;
    }
}


